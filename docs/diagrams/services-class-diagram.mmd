classDiagram
    direction LR

    class IPetService {
        <<interface>>
        +SearchPetsAsync(query, token) Task~List~PetResponse~~
        +GetPetAsync(id, token) Task~PetResponse~
        +CreatePetAsync(request, token) Task~PetResponse~
        +UpdatePetAsync(id, request, token) Task
        +DeletePetAsync(id, token) Task
    }
    class IShelterService {
        <<interface>>
        +GetSheltersAsync(token) Task~List~ShelterResponse~~
        +GetShelterAsync(id, token) Task~ShelterResponse~
        +GetShelterPetsAsync(id, token) Task~List~PetResponse~~
        +CreateShelterAsync(request, token) Task~ShelterResponse~
        +UpdateShelterAsync(id, request, token) Task
        +DeleteShelterAsync(id, token) Task
    }
    class IUserService {
        <<interface>>
        +GetMyProfileAsync(subject, token) Task~UserResponse~
        +CreateOrUpdateMyProfileAsync(subject, request, token) Task
    }
    class IAdoptionService {
        <<interface>>
        +ApplyAsync(userId, request, token) Task~AdoptionResponse~
        +GetMineAsync(userId, token) Task~List~AdoptionResponse~~
        +GetAsync(id, requesterUserId, canReview, token) Task~AdoptionResponse~
        +SearchAsync(query, token) Task~List~AdoptionResponse~~
        +ApproveAsync(id, token) Task
        +RejectAsync(id, token) Task
    }
    class IAppointmentService {
        <<interface>>
        +GetForUserAsync(userId, token) Task~IReadOnlyList~AppointmentResponse~~
        +CreateAsync(userId, request, token) Task~AppointmentResponse~
        +CancelAsync(userId, id, token) Task~bool~
    }
    class INotificationService {
        <<interface>>
        +GetForUserAsync(userId, unreadOnly, token) Task~IReadOnlyList~NotificationResponse~~
        +CreateAsync(userId, message, token) Task
        +MarkAsReadAsync(userId, id, token) Task~bool~
    }
    class ICurrentUser {
        <<interface>>
        +Subject string
        +UserId int
    }
    class SubjectToUserIdClaimsTransformation {
        +TransformAsync(principal) ClaimsPrincipal
    }
    class IUnitOfWork {
        <<interface>>
        +SaveChangesAsync(token) Task~int~
    }

    IPetService <|.. PetService
    IShelterService <|.. ShelterService
    IUserService <|.. UserService
    IAdoptionService <|.. AdoptionService
    IAppointmentService <|.. AppointmentService
    INotificationService <|.. NotificationService
    ICurrentUser <|.. HttpCurrentUser

    PetService --> IPetRepository
    PetService --> IShelterRepository
    ShelterService --> IShelterRepository
    UserService --> IUserRepository
    AdoptionService --> IAdoptionRepository
    AdoptionService --> IPetRepository
    AdoptionService --> INotificationService : notifies applicants
    AppointmentService --> IAppointmentRepository
    AppointmentService --> INotificationService : notifies on book and cancel
    NotificationService --> INotificationRepository
    PetService --> IUnitOfWork
    ShelterService --> IUnitOfWork
    UserService --> IUnitOfWork
    AdoptionService --> IUnitOfWork : one save per approve or reject
    AppointmentService --> IUnitOfWork
    NotificationService --> IUnitOfWork
    SubjectToUserIdClaimsTransformation --> IUserRepository : maps sub to ExternalId
    HttpCurrentUser ..> SubjectToUserIdClaimsTransformation : reads local_user_id claim
