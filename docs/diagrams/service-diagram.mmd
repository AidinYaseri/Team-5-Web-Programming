flowchart LR
    Browser[Browser]
    Client[Animal.Client<br/>Blazor Server]
    Identity[OIDC identity provider]

    subgraph API["Animal.API · REST endpoints"]
        direction TB
        Pets[PetsController]
        Shelters[SheltersController]
        Users[UsersController]
        Adoptions[AdoptionsController]
        Appointments[AppointmentsController]
        Notifications[NotificationsController]
        Auth[JWT bearer + scope policies<br/>deny by default]
        Services[Application services]
    end

    subgraph DOMAIN["Animal.Domain · entities and rules"]
        Rules[PetRules · ShelterRules · UserRules<br/>AdoptionRules · AppointmentRules · NotificationRules]
        Entities[Pets · Shelters · Users<br/>Adoptions · Appointments · Notifications]
    end

    subgraph DATA["Animal.Data · EF Core"]
        Repos[Repositories]
        UserRepo[UserRepository · ExternalId lookup]
        UnitOfWork[IUnitOfWork]
        Context[AnimalDbContext<br/>Configurations and migrations]
    end

    Database[(SQL Server)]

    Browser <-->|interactive UI and sign-in cookie| Client
    Client <-->|OIDC authorization code + PKCE| Identity
    Client -->|HTTP / JSON + bearer access token| API
    Auth -->|validated sub| UserRepo
    UserRepo -->|local user ID| Auth
    Auth -->|authorized requests| Services
    Pets --> Services
    Shelters --> Services
    Users --> Services
    Adoptions --> Services
    Appointments --> Services
    Notifications --> Services
    Services --> Rules
    Services --> Entities
    Services --> Repos
    Services --> UnitOfWork
    UnitOfWork -->|one save for related changes| Context
    Repos --> Context
    Context --> Database
