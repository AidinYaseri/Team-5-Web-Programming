@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccessTokenProvider AccessTokenProvider
@inject NotificationsApiClient NotificationsApi
@inject NotificationCountState NotificationCountState

<header class="site-header">
    <a class="brand" href="">Animal Adoption</a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="pets">Pets</NavLink>
        <NavLink href="shelters">Shelters</NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink href="profile">My profile</NavLink>
                <NavLink href="notifications">🔔 Notifications @if (NotificationCountState.UnreadCount > 0) { <span class="unread-count">@NotificationCountState.UnreadCount</span> }</NavLink>
                <NavLink href="appointments">My appointments</NavLink>
                <NavLink href="applications">My applications</NavLink>
                <NavLink href="applications/review">Review applications</NavLink>
                <form method="post" action="/auth/logout" class="inline-form">
                    <AntiforgeryToken />
                    <button class="link-button" type="submit">Sign out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a href="/auth/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

<main class="content">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _loaded;

    protected override void OnInitialized() => NotificationCountState.Changed += OnNotificationCountChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
        {
            return;
        }

        _loaded = true;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        try
        {
            await AccessTokenProvider.RefreshAsync();
            NotificationCountState.SetUnreadCount((await NotificationsApi.GetAsync(unreadOnly: true)).Count);
            StateHasChanged();
        }
        catch (ApiException)
        {
            // A missing or expired API scope is shown when the user opens notifications.
        }
        catch (HttpRequestException)
        {
            // Keep the shell usable while the API is offline.
        }
    }

    private void OnNotificationCountChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => NotificationCountState.Changed -= OnNotificationCountChanged;
}
