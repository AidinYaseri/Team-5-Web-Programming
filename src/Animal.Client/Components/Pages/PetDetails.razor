@page "/pets/{Id:int}"
@rendermode InteractiveServer
@inject PetsApiClient Api

<PageTitle>Pet details</PageTitle>

@if (_notFound)
{
    <p>That pet doesn't exist. <a href="/pets">Back to pets</a></p>
}
else if (_pet is null)
{
    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
    else
    {
        <p>Loading pet…</p>
    }
}
else
{
    <div class="page-heading">
        <h1>@_pet.Name</h1>
        @* The button only shows for signed-in users; the API still requires the pets.write scope. *@
        <AuthorizeView>
            <Authorized>
                <a class="button" href="/pets/@_pet.Id/edit">Edit</a>
            </Authorized>
        </AuthorizeView>
    </div>

    <dl class="details">
        <dt>Species</dt><dd>@_pet.Species</dd>
        <dt>Breed</dt><dd>@(string.IsNullOrWhiteSpace(_pet.Breed) ? "Not listed" : _pet.Breed)</dd>
        <dt>Age</dt><dd>@_pet.Age</dd>
        <dt>Status</dt><dd>@(_pet.IsAvailable ? "Available" : "Adopted")</dd>
        <dt>Shelter</dt><dd>@_pet.ShelterId</dd>
    </dl>
    @if (_pet.IsAvailable)
    {
        <p><a class="button" href="/pets/@_pet.Id/visit">Book a visit</a></p>
    }
    <p><a href="/pets">Back to pets</a></p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PetResponse? _pet;
    private bool _notFound;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = false;
        _error = null;

        try
        {
            _pet = await Api.GetPetAsync(Id);
            if (_pet is null)
            {
                _notFound = true;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _pet = null;
        }
        catch (HttpRequestException)
        {
            _error = "Can't reach the API. Is Animal.API running?";
            _pet = null;
        }
    }
}
