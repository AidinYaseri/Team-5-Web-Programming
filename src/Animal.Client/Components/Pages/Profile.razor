@page "/profile"
@rendermode InteractiveServer
@inject UsersApiClient Api

<PageTitle>My profile</PageTitle>

<h1>My profile</h1>

@if (_unauthorized)
{
    <p role="alert">Please sign in to see your profile.</p>
}
else if (_model is null)
{
    @if (_errors.Count > 0)
    {
        <ul class="error" role="alert">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    }
    else
    {
        <p>Loading...</p>
    }
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="profile-form" FormName="profile">
        <DataAnnotationsValidator />

        <label>
            Name
            <InputText @bind-Value="_model.Name" />
            <ValidationMessage For="() => _model.Name" />
        </label>
        <label>
            Email
            <InputText @bind-Value="_model.Email" type="email" />
            <ValidationMessage For="() => _model.Email" />
        </label>
        <label>
            Phone number
            <InputText @bind-Value="_model.PhoneNumber" type="tel" />
            <ValidationMessage For="() => _model.PhoneNumber" />
        </label>

        @if (_errors.Count > 0)
        {
            <ul class="error" role="alert">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        @if (_profileNotice is not null)
        {
            <p class="success" role="status">@_profileNotice</p>
        }

        <div class="form-actions">
            <button type="submit" disabled="@_saving">@(_saving ? "Saving..." : "Save")</button>
        </div>
    </EditForm>

    <section class="profile-picture-editor" aria-labelledby="profile-picture-heading">
        <h2 id="profile-picture-heading">Profile picture</h2>
        @if (_pictureDataUrl is null)
        {
            <div class="profile-picture-placeholder" role="img" aria-label="No profile picture">
                No profile picture
            </div>
        }
        else
        {
            <img class="profile-picture" src="@_pictureDataUrl" alt="Your profile picture" />
        }

        @if (_pictureError is not null)
        {
            <p class="error" role="alert">@_pictureError</p>
        }

        @if (_pictureNotice is not null)
        {
            <p class="success" role="status">@_pictureNotice</p>
        }

        @if (!_hasSavedProfile)
        {
            <p>Save your profile details before adding a picture.</p>
        }

        <label>
            Upload a PNG or JPEG (maximum 2 MB)
            <InputFile OnChange="UploadPictureAsync"
                       accept="image/png,image/jpeg"
                       disabled="@(!_hasSavedProfile || _pictureBusy)" />
        </label>

        @if (_pictureDataUrl is not null)
        {
            <button type="button" class="danger" @onclick="RemovePictureAsync" disabled="@_pictureBusy">
                @(_pictureBusy ? "Please wait..." : "Remove picture")
            </button>
        }
    </section>
}

@code {
    private const long MaxPictureBytes = 2 * 1024 * 1024;
    private UpdateUserRequest? _model;
    private string? _pictureDataUrl;
    private string? _pictureError;
    private string? _pictureNotice;
    private string? _profileNotice;
    private bool _unauthorized;
    private bool _saving;
    private bool _hasSavedProfile;
    private bool _pictureBusy;
    private List<string> _errors = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var profile = await Api.GetMyProfileAsync();
            _hasSavedProfile = profile is not null;
            _model = profile is null
                ? new UpdateUserRequest()
                : UpdateUserRequest.FromResponse(profile);

            if (profile is not null)
            {
                try
                {
                    var picture = await Api.GetMyProfilePictureAsync();
                    _pictureDataUrl = picture is null ? null : ToDataUrl(picture);
                }
                catch (ApiException ex)
                {
                    _pictureError = PictureErrorMessage(ex);
                }
                catch (HttpRequestException)
                {
                    _pictureError = "Can't reach the API to load your profile picture.";
                }
            }
        }
        catch (ApiException ex)
        {
            HandleApiError(ex);
        }
        catch (HttpRequestException)
        {
            _errors = ["Can't reach the API. Is Animal.API running?"];
        }

        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _errors = [];
        _profileNotice = null;
        _saving = true;

        try
        {
            await Api.UpdateMyProfileAsync(_model!);
            _hasSavedProfile = true;
            _profileNotice = "Profile saved.";
        }
        catch (ApiException ex)
        {
            HandleApiError(ex);
        }
        catch (HttpRequestException)
        {
            _errors = ["Can't reach the API. Is Animal.API running?"];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadPictureAsync(InputFileChangeEventArgs args)
    {
        _pictureError = null;
        _pictureNotice = null;

        var file = args.File;
        if (file.Size > MaxPictureBytes)
        {
            _pictureError = "Choose a picture that is no larger than 2 MB.";
            return;
        }

        if (file.ContentType is not ("image/png" or "image/jpeg"))
        {
            _pictureError = "Choose a PNG or JPEG image.";
            return;
        }

        _pictureBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaxPictureBytes);
            await Api.UploadMyProfilePictureAsync(stream, file.Name, file.ContentType);

            var savedPicture = await Api.GetMyProfilePictureAsync();
            if (savedPicture is null)
            {
                _pictureError = "The API did not return the uploaded picture. Your previous picture is unchanged.";
                return;
            }

            _pictureDataUrl = ToDataUrl(savedPicture);
            _pictureNotice = "Profile picture uploaded.";
        }
        catch (ApiException ex)
        {
            _pictureError = PictureErrorMessage(ex);
        }
        catch (HttpRequestException)
        {
            _pictureError = "Can't reach the API to upload your profile picture.";
        }
        catch (IOException)
        {
            _pictureError = "Choose a picture that is no larger than 2 MB.";
        }
        finally
        {
            _pictureBusy = false;
        }
    }

    private async Task RemovePictureAsync()
    {
        _pictureError = null;
        _pictureNotice = null;
        _pictureBusy = true;

        try
        {
            await Api.DeleteMyProfilePictureAsync();
            _pictureDataUrl = null;
            _pictureNotice = "Profile picture removed.";
        }
        catch (ApiException ex)
        {
            _pictureError = PictureErrorMessage(ex);
        }
        catch (HttpRequestException)
        {
            _pictureError = "Can't reach the API to remove your profile picture.";
        }
        finally
        {
            _pictureBusy = false;
        }
    }

    private void HandleApiError(ApiException exception)
    {
        if (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            _unauthorized = true;
            _model = null;
            _errors = [];
            return;
        }

        _errors = [.. exception.Errors.DefaultIfEmpty(
            exception.StatusCode switch
            {
                System.Net.HttpStatusCode.BadRequest => "Please correct the highlighted profile information.",
                System.Net.HttpStatusCode.Conflict => "That email address is already in use.",
                _ => exception.Message
            })];
    }

    private static string ToDataUrl(ProfilePictureImage picture) =>
        $"data:{picture.ContentType};base64,{Convert.ToBase64String(picture.Bytes)}";

    private static string PictureErrorMessage(ApiException exception) => exception.StatusCode switch
    {
        System.Net.HttpStatusCode.BadRequest => exception.Errors.FirstOrDefault()
            ?? "The profile picture is invalid. Choose a PNG or JPEG under 2 MB.",
        System.Net.HttpStatusCode.Unauthorized => "Please sign in again to view your profile picture.",
        System.Net.HttpStatusCode.NotFound => "Your profile could not be found. Save your profile details before changing its picture.",
        _ => exception.Message
    };
}
