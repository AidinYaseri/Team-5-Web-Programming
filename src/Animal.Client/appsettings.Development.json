{
  "Authentication": {
    // Local Keycloak realm (docs/milestone-4/identity-provider-setup.md). The client secret is NOT here:
    // dotnet user-secrets set "Authentication:ClientSecret" "<secret from Keycloak>" --project src/Animal.Client
    "Authority": "http://localhost:8080/realms/animal",
    "ClientId": "animal-client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
