{
  "ConnectionStrings": {
    "AnimalDb": "Server=(localdb)\\mssqllocaldb;Database=AnimalAdoption;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cors": {
    "ClientOrigin": "http://localhost:5012"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    // Local Keycloak realm (docs/milestone-4/identity-provider-setup.md). HTTP is only accepted in Development.
    "Authority": "http://localhost:8080/realms/animal",
    // Added to the token by the audience mapper on animal-client.
    "Audience": "animal-api"
  }
}
