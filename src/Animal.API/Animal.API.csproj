<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets a developer override ConnectionStrings:AnimalDb locally (dotnet user-secrets). Never put credentials in appsettings. -->
    <UserSecretsId>animal-api-3d9e4a1c-team5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- SkiaSharp ships the Windows/macOS native library; Linux (CI on Ubuntu, containers) needs this one too. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Animal.Domain\Animal.Domain.csproj" />
    <ProjectReference Include="..\Animal.Data\Animal.Data.csproj" />
  </ItemGroup>

</Project>
